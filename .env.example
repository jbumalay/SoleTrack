# SoleTrack — example environment (placeholder values only, never real secrets)
# Copy to .env and adjust:  copy .env.example .env   (PowerShell: Copy-Item .env.example .env)

# App port (read from PORT in server/config.ts, defaults to 3000)
PORT=3000

# Database (app defaults shown; XAMPP defaults to 3306 — set DB_PORT=3306 for XAMPP)
DB_HOST=127.0.0.1
DB_PORT=3308
DB_USER=root
DB_PASS=
DB_NAME=soletrack_node
